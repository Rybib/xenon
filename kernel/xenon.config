# Xenon kernel configuration fragment.
# Applied on top of Debian's kernel configuration by build-kernel.sh.
# Every option here is either already in Debian's backports kernel (and is
# listed to make the dependency explicit) or is a Xenon tuning choice.

# --- Windows compatibility -------------------------------------------------
# NT synchronization primitives (mutexes, semaphores, events) for Wine.
CONFIG_NTSYNC=m
# Run Windows .exe files directly (registered by xenon-xws).
CONFIG_BINFMT_MISC=m
# Case-insensitive directories (ext4 casefold) for Windows programs.
CONFIG_UNICODE=y

# --- Latency and gaming ----------------------------------------------------
# Preemption model selectable at boot; Xenon boots with preempt=full.
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_VOLUNTARY=y
# 1000 Hz tick: finer timer resolution for games and audio.
# CONFIG_HZ_250 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# sched_ext: pluggable BPF CPU schedulers (scx_lavd, scx_bpfland) to
# evaluate against EEVDF for gaming. Needs BTF.
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y
# futex_waitv (used by Wine's fsync path and by many native games).
CONFIG_FUTEX=y
# Transparent huge pages on request (madvise) helps large game heaps.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- Future Xenon kernel modules in Rust -------------------------------------
# Requires the exact rustc/bindgen versions the kernel release documents.
# Enable with: ./build-kernel.sh --rust
# CONFIG_RUST=y
