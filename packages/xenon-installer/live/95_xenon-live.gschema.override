# Live session only (removed by the installer).
[org.gnome.shell]
welcome-dialog-last-shown-version='9999'
favorite-apps=['xenon-install.desktop', 'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.xenon.Settings.desktop']

[org.gnome.desktop.screensaver]
lock-enabled=false

[org.gnome.desktop.session]
idle-delay=uint32 0

# The live session runs from RAM: don't refresh package lists or download
# updates into it (the installed system does this normally).
[org.gnome.software]
download-updates=false
allow-updates=false
refresh-when-metered=false
