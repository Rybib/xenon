# Live session only (removed by the installer).
[org.gnome.shell]
favorite-apps=['xenon-install.desktop', 'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'xenon-settings.desktop']

[org.gnome.desktop.screensaver]
lock-enabled=false

[org.gnome.desktop.session]
idle-delay=uint32 0
