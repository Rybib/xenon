# Xenon follows Debian stable, with a newer kernel, graphics stack and
# NVIDIA driver from Debian's official backports archive (newer GPU and
# hardware support, NTSYNC). Everything else stays on stable.
Package: src:linux src:linux-signed-amd64 src:firmware-nonfree src:firmware-free
Pin: release n=trixie-backports
Pin-Priority: 990

Package: src:mesa src:libdrm src:vulkan-loader src:llvm-toolchain-*
Pin: release n=trixie-backports
Pin-Priority: 990

Package: src:nvidia-graphics-drivers src:nvidia-open-gpu-kernel-modules src:nvidia-settings src:nvidia-graphics-drivers-tesla*
Pin: release n=trixie-backports
Pin-Priority: 990
