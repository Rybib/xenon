#!/bin/sh
# Xenon Windows Subsystem: 32-bit support, WineHQ stable, the Xenon
# packages (which depend on Wine), and the Wine Mono/Gecko add-ons so new
# Windows environments are created without download prompts.
set -e
export DEBIAN_FRONTEND=noninteractive

dpkg --add-architecture i386
apt-get update

# 32-bit graphics drivers for 32-bit Windows games. They must match the
# 64-bit Mesa version exactly (Multi-Arch: same), which comes from backports.
MESA_VER=$(dpkg-query -W -f='${Version}' libgbm1)
echo "64-bit Mesa: $MESA_VER"
apt-cache policy libgbm1:i386 libgl1-mesa-dri:i386 mesa-vulkan-drivers:i386 || true
if ! apt-get install -y --no-install-recommends \
        "mesa-vulkan-drivers:i386=$MESA_VER" "libgl1-mesa-dri:i386=$MESA_VER" \
        "libglx-mesa0:i386=$MESA_VER" "libgbm1:i386=$MESA_VER" \
        "mesa-libgallium:i386=$MESA_VER"; then
    echo "WARNING: 32-bit Mesa $MESA_VER is not available; 32-bit games will lack GPU drivers"
fi
apt-get install -y --no-install-recommends gamemode:i386 libgamemodeauto0:i386 || \
    echo "WARNING: 32-bit GameMode not installed"

apt-get install -y --install-recommends winehq-stable

# Xenon's own packages, staged by build-iso.sh.
apt-get install -y /var/cache/xenon-debs/*.deb
rm -rf /var/cache/xenon-debs

/usr/lib/xenon/xws/fetch-wine-addons

wine --version
