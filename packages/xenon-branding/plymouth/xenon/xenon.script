// Xenon boot splash: logo on a dark field with a softly pulsing row of
// dots, plus a disk-encryption password prompt when LUKS is used.

Window.SetBackgroundTopColor(0.055, 0.067, 0.133);
Window.SetBackgroundBottomColor(0.020, 0.027, 0.059);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = Window.GetX() + screen_w / 2;
cy = Window.GetY() + screen_h / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 40, 10);

NDOTS = 5;
dot_image = Image("bullet.png");
for (i = 0; i < NDOTS; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetPosition(cx - (NDOTS * 24) / 2 + i * 24 + 6, cy + logo.image.GetHeight() / 2 + 20, 10);
    dots[i].SetOpacity(0.25);
}

frame = 0;
dots_visible = 1;
fun refresh_callback() {
    frame++;
    if (!dots_visible) return;
    lit = Math.Int(frame / 8) % NDOTS;
    for (i = 0; i < NDOTS; i++) {
        if (i == lit) dots[i].SetOpacity(1);
        else if (i == (lit + NDOTS - 1) % NDOTS) dots[i].SetOpacity(0.55);
        else dots[i].SetOpacity(0.2);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---- password prompt (encrypted disks) ----
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
prompt_sprite = Sprite();
entry_sprite = Sprite();
bullets[0] = Sprite(bullet.image);
bullets[0].SetOpacity(0);

fun set_dots(op) {
    for (i = 0; i < NDOTS; i++) dots[i].SetOpacity(op);
}

fun display_password_callback(prompt, bullet_count) {
    dots_visible = 0;
    set_dots(0);
    prompt_img = Image.Text(prompt, 0.85, 0.88, 1.0);
    prompt_sprite.SetImage(prompt_img);
    prompt_sprite.SetPosition(cx - prompt_img.GetWidth() / 2, cy + 110, 20);
    prompt_sprite.SetOpacity(1);
    entry_sprite.SetImage(entry.image);
    ex = cx - entry.image.GetWidth() / 2;
    ey = cy + 140;
    entry_sprite.SetPosition(ex, ey, 20);
    entry_sprite.SetOpacity(1);
    for (i = 0; i < 20; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(ex + 14 + i * 16, ey + 14, 21);
        if (i < bullet_count) bullets[i].SetOpacity(1);
        else bullets[i].SetOpacity(0);
    }
}

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
    for (i = 0; i < 20; i++) {
        if (bullets[i]) bullets[i].SetOpacity(0);
    }
    dots_visible = 1;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---- status messages (e.g. "Checking disk...") ----
message_sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.7, 0.72, 0.85);
    message_sprite.SetImage(img);
    message_sprite.SetPosition(cx - img.GetWidth() / 2, screen_h - 60, 10);
}
Plymouth.SetMessageFunction(message_callback);
