#!/usr/bin/make -f

%:
	dh $@ --with python3

override_dh_auto_configure:

override_dh_auto_build:
	$(MAKE) -C packages/xenon-branding OUT=build
	mkdir -p packages/xenon-installer/build
	cp packages/xenon-branding/build/misc/xenon-logo-128.png packages/xenon-installer/build/xenon-logo.png
	cp packages/xenon-branding/build/misc/xenon-wordmark-dark.png packages/xenon-installer/build/welcome.png

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	python3 -m pytest -q -p no:cacheprovider packages/xenon-xws/tests/test_units.py \
		packages/xenon-settings/tests -k "not real_binaries"
endif

override_dh_auto_install:

override_dh_auto_clean:
	$(MAKE) -C packages/xenon-branding clean
	rm -rf packages/xenon-installer/build

override_dh_python3:
	dh_python3 -p xenon-xws /usr/lib/xenon/xws
	dh_python3 -p xenon-settings /usr/lib/xenon/settings
